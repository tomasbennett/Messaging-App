generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  password String

  conversations ConversationParticipant[]

  profileImgId String? @db.Uuid
  profileImg   File?   @relation("UserProfileImage", fields: [profileImgId], references: [id])

  


  refreshTokens RefreshToken[]  

  receivedFriendRequests ConversationJoinRequest[] @relation("ReceivedRequests")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ConversationJoinRequest {
  id String @id @default(uuid()) @db.Uuid

  senderParticipantId String @db.Uuid
  senderParticipant   ConversationParticipant   @relation("SentRequests", fields: [senderParticipantId], references: [id])

  receiverId String @db.Uuid
  receiver   User   @relation("ReceivedRequests", fields: [receiverId], references: [id])

  conversationId String @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  status InviteStatus @default(PENDING)

  sentAt DateTime @default(now())

}








model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  chatName     String

  participants ConversationParticipant[]
  messages     Message[]

  groupChatImgId String? @db.Uuid
  groupChatImg   File?   @relation("GroupChatImage", fields: [groupChatImgId], references: [id])

  conversationInvitations ConversationJoinRequest[]
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id])

  messages         Message[]    @relation("MessagesSentByParticipant")  

  sentConversationRequests ConversationJoinRequest[] @relation("SentRequests")

  lastReadAt       DateTime     @default(now())

  hasLeft           Boolean      @default(false)


  @@unique([conversationId, userId])

}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  content   String?
  createdAt DateTime @default(now())

  senderId  String   @db.Uuid
  sender    ConversationParticipant     @relation("MessagesSentByParticipant", fields: [senderId], references: [id])


  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  files File[]
}













model File {
  id         String   @id @default(uuid()) @db.Uuid
  filename   String
  filesize   Int
  filetype   String
  uploadedAt DateTime @default(now())

  supabaseFileId String @unique

  messageId String?   @db.Uuid
  message   Message?  @relation(fields: [messageId], references: [id])


  userProfileImageFor User[] @relation("UserProfileImage")

  groupChatImageFor Conversation[] @relation("GroupChatImage")
}




model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique

  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])

  // expiresAt DateTime
}